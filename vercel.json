{
  "buildCommand": "./gradlew :shared:wasmJsBrowserDistribution",
  "outputDirectory": "shared/build/dist/wasmJs/productionExecutable",
  "installCommand": "chmod +x gradlew",
  "framework": null,
  "rewrites": [
    { "source": "/api/proxy-img", "destination": "/api/proxy-img" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.wasm)",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Embedder-Policy", "value": "require-corp" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    }
  ]
}
